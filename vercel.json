{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/hls", "destination": "/api/proxy?__route=hls" },
    { "source": "/segment", "destination": "/api/proxy?__route=segment" },
    { "source": "/video", "destination": "/api/proxy?__route=video" },
    { "source": "/health", "destination": "/api/proxy?__route=health" },
    { "source": "/", "destination": "/api/proxy?__route=health" }
  ]
}
